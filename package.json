{
  "name": "data-explorer-view",
  "version": "1.3.0",
  "description": "Widgets and view model for Simulink data files, built on data-explorer-core",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathworks/data-explorer-view.git"
  },
  "bugs": {
    "url": "https://github.com/mathworks/data-explorer-view/issues"
  },
  "homepage": "https://github.com/mathworks/data-explorer-view#readme",
  "files": [
    "dist",
    "icons",
    "src/theme",
    "custom-elements.json",
    "docs"
  ],
  "sideEffects": [
    "*.css"
  ],
  "customElements": "custom-elements.json",
  "exports": {
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./serve": {
      "types": "./dist/serve/index.d.ts",
      "default": "./dist/serve/index.js"
    },
    "./tree-table": {
      "types": "./dist/widgets/tree-table/index.d.ts",
      "default": "./dist/widgets/tree-table/index.js"
    },
    "./property-inspector": {
      "types": "./dist/widgets/property-inspector/index.d.ts",
      "default": "./dist/widgets/property-inspector/index.js"
    },
    "./variable-editor": {
      "types": "./dist/widgets/variable-editor/index.d.ts",
      "default": "./dist/widgets/variable-editor/index.js"
    },
    "./context-menu": {
      "types": "./dist/widgets/context-menu/index.d.ts",
      "default": "./dist/widgets/context-menu/index.js"
    },
    "./error-dialog": {
      "types": "./dist/widgets/error-dialog/index.d.ts",
      "default": "./dist/widgets/error-dialog/index.js"
    },
    "./project-page": {
      "types": "./dist/widgets/project-page/index.d.ts",
      "default": "./dist/widgets/project-page/index.js"
    },
    "./hierarchy": {
      "types": "./dist/widgets/hierarchy/index.d.ts",
      "default": "./dist/widgets/hierarchy/index.js"
    },
    "./icon": {
      "types": "./dist/widgets/icon/index.d.ts",
      "default": "./dist/widgets/icon/index.js"
    },
    "./icon-assets": {
      "types": "./dist/widgets/icon-assets/index.d.ts",
      "default": "./dist/widgets/icon-assets/index.js"
    },
    "./theme.css": "./src/theme/tokens.css",
    "./icons/*": "./icons/*"
  },
  "scripts": {
    "build": "node scripts/gen-icon-assets.mjs && tsc -p tsconfig.build.json && npm run build:api",
    "build:api": "cem analyze --config custom-elements-manifest.config.mjs --quiet && node scripts/gen-widget-docs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.model.json",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:leak": "node scripts/leak-check.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run check:boundary && npm run build && npm run check:api && npm run test && npm run check:leak",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "tsc -p gallery/tsconfig.json && vite build --config gallery/vite.config.ts",
    "test:gallery": "playwright test -c gallery/playwright.config.ts"
  },
  "peerDependencies": {
    "data-explorer-core": "^1.54.0",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "1.62.0",
    "data-explorer-core": "github:mathworks/data-explorer-core#v1.54.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.9.0",
    "lit": "^3.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
